# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (the documented example is safe to commit)
.env*
!.env.example

# vercel
.vercel

# typescript
next-env.d.ts
# Incremental build cache, written by `tsc --noEmit` and `next build`. It only
# showed up once a build was run locally (12 September 2026); CI builds in a
# throwaway checkout and never noticed.
*.tsbuildinfo
/dist/
/.wrangler/
/.sites-runtime/
/outputs/
/work/
/deploy-package/

# Incremental build cache from `tsc --noEmit` / `next build`. Only appears once
# a build is run locally; CI uses a throwaway checkout and never saw it.
*.tsbuildinfo
