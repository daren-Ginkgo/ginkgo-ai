# Azure Table Storage used for beta applications, the live place counter and
# first-party conversion events. Set the real value in Azure App Service only.
AZURE_STORAGE_CONNECTION_STRING=

# Only this Microsoft 365 identity may open /funnel in production.
FUNNEL_ADMIN_EMAIL=daren@ginkgofinancial.com

# Optional local-development bypass. Never set this in Azure production.
DEV_ADMIN_EMAIL=

# FCA Financial Services Register API (free but keyed - register at
# https://register.fca.org.uk/Developer). Powers the advisory FCA check in
# /funnel. Without these the check reports itself unavailable.
FCA_API_EMAIL=
FCA_API_KEY=
